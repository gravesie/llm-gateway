# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are the only place provider credentials live for this project.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Where cost records are written. One JSON object per line.
# Leave this unset and nothing is recorded at all; the calls still work.
LLM_GATEWAY_COST_LOG=costs/spend.jsonl

# US dollars per pound, used to convert costs to GBP. Optional.
# Unset uses the rate built into the library, which carries the source and date it was
# read. Every record states the rate it used, so GBP figures can always be recomputed.
LLM_GATEWAY_USD_GBP_RATE=

# Hard ceiling in GBP per calendar month (UTC), across all providers. Checked before each
# call, not after it: once measured spend for the month reaches this, complete() raises
# BudgetExceeded and nothing is sent to a provider.
#
# Enforced against the cost log above, so LLM_GATEWAY_COST_LOG must also be set. Set this
# without one and every call is refused with BudgetMisconfigured, rather than the ceiling
# silently doing nothing.
#
# Leave it empty for no ceiling. 0 is a valid setting and means spend nothing this month.
# The ceiling can only see spend it could price: streaming calls and unpriced modifiers are
# counted separately and reported, never estimated. See README.md.
LLM_GATEWAY_MONTHLY_BUDGET_GBP=

# Set to 1 to bypass the router and call the named provider directly.
# For diagnosing whether a fault is the router's or the provider's.
#
# Not implemented yet — there is no router to bypass. When it is, it will not switch off
# the spend ceiling or cost logging; a variable that silently disables a spend cap would
# get set during an incident, which is exactly when the cap matters.
LLM_GATEWAY_BYPASS=0
