# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are the only place provider credentials live for this project.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Where cost records are written. One JSON object per line.
# Leave this unset and nothing is recorded at all; the calls still work.
LLM_GATEWAY_COST_LOG=costs/spend.jsonl

# US dollars per pound, used to convert costs to GBP. Optional.
# Unset uses the rate built into the library, which carries the source and date it was
# read. Every record states the rate it used, so GBP figures can always be recomputed.
LLM_GATEWAY_USD_GBP_RATE=

# Hard ceiling in GBP per calendar month (UTC), across all providers. Checked before each
# call, not after it: once measured spend for the month reaches this, complete() raises
# BudgetExceeded and nothing is sent to a provider.
#
# Enforced against the cost log above, so LLM_GATEWAY_COST_LOG must also be set. Set this
# without one and every call is refused with BudgetMisconfigured, rather than the ceiling
# silently doing nothing.
#
# Leave it empty for no ceiling. 0 is a valid setting and means spend nothing this month.
# The ceiling can only see spend it could price: streaming calls and unpriced modifiers are
# counted separately and reported, never estimated. See README.md.
LLM_GATEWAY_MONTHLY_BUDGET_GBP=

# Ceilings for individual workloads, as a JSON object mapping a workload label to pounds
# per calendar month. Layered on top of the ceiling above, not a replacement for it: a call
# is refused once either the global ceiling or one set for its own label is reached, so one
# consumer running away no longer stops the others.
#
#   LLM_GATEWAY_WORKLOAD_BUDGETS_GBP={"web-auditor":5,"moto:bulk":20}
#
# A key matches a label exactly, or as a prefix at a ":" boundary — "web-auditor" caps
# everything that application does, "web-auditor:crawl" caps only that operation, and both
# apply at once when both are set. "web" does NOT cap "web-auditor"; matching is by segment,
# not by characters.
#
# Needs LLM_GATEWAY_COST_LOG for the same reason the ceiling above does. Leave it empty for
# no per-workload ceilings; {} means the same. 0 is valid and stops that workload only.
# Anything that cannot be parsed — bad JSON, a blank label, a value that is not a
# non-negative number, two keys that are the same once trimmed — refuses every call rather
# than leaving a workload silently uncapped.
LLM_GATEWAY_WORKLOAD_BUDGETS_GBP=

# Set to 1 to switch off routing. A ladder is then truncated to its first rung: one
# attempt, no escalation and no fallback to another model, which is the call the caller
# would have made without this library routing it. For diagnosing whether a fault is the
# router's or the provider's.
#
# It changes nothing else. The spend ceiling above is still enforced and every call is
# still recorded — a variable that silently disabled a spend cap would get set during an
# incident, which is exactly when the cap matters. A record whose ladder was suppressed
# says so, with reason "bypass_no_escalation".
#
# 1, true, yes or on switch it on; 0, false, no, off, empty and unset leave it off.
# Anything else is treated as off and warned about, rather than guessed at.
LLM_GATEWAY_BYPASS=0
